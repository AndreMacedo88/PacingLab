<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Weather for where the phone roughly is; asked for only when the weather card is shown. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Forecasts are downloaded from Open-Meteo. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The morning and gym reminders, only when the athlete switches them on in Settings. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- Morning checks for last night, set by MorningCheck while the morning reminder is on. -->
        <receiver
            android:name="app.pacinglab.core.data.reminder.MorningCheckReceiver"
            android:exported="false" />
    </application>

</manifest>
