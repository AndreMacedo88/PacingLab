<?xml version="1.0" encoding="utf-8"?>
<!--
    Health data never goes to cloud backup. Moving to a new phone with a direct
    device-to-device transfer still carries PacingLab's data across.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
</data-extraction-rules>
