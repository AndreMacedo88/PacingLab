<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
            Debug builds only: posts both question notifications, to check how they look on a phone.
            adb shell am broadcast -n app.pacinglab.debug/app.pacinglab.notification.ShowQuestionsReceiver
            Only the shell holds DUMP, so no other app can send it.
        -->
        <receiver
            android:name="app.pacinglab.notification.ShowQuestionsReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
