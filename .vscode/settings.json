{
  "terminal.integrated.env.linux": {
    "JAVA_HOME": "${workspaceFolder}/.toolchain/jdk",
    "ANDROID_HOME": "${workspaceFolder}/.toolchain/android-sdk",
    "ANDROID_USER_HOME": "${workspaceFolder}/.toolchain/android-user",
    "PATH": "${workspaceFolder}/.toolchain/jdk/bin:${workspaceFolder}/.toolchain/android-sdk/platform-tools:${workspaceFolder}/.toolchain/android-sdk/emulator:${env:PATH}",
    "ANDROID_AVD_HOME": "${workspaceFolder}/.toolchain/android-user/avd"
  },
  "files.exclude": {
    "**/.gradle": true,
    "**/build": true,
    ".kotlin": true,
    ".toolchain": true
  },
  "search.exclude": {
    "**/build": true,
    ".toolchain": true,
    "**/src/test/screenshots": true
  },
  "files.watcherExclude": {
    "**/build/**": true,
    ".toolchain/**": true,
    ".gradle/**": true
  },
  "editor.rulers": [
    140
  ],
  "[kotlin]": {
    "editor.tabSize": 4
  }
}
